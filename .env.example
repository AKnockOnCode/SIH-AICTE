# AgniDrishti configuration. Copy to `.env` (scripts/dev.sh does this on first run). Real environment
# variables take precedence. Never commit a real `.env`.

# Database (SQLite only in this build). Relative paths are resolved from the repository root.
DATABASE_URL=sqlite:///backend/var/agnidrishti.db

# Synthetic demo data. The dataset is generated on first start when the database is empty.
AGNIDRISHTI_SEED=26264
# Dataset "today" used when seeding (YYYY-MM-DD). Empty = the date of first seeding.
AGNIDRISHTI_SEED_ANCHOR=
# Freeze the application's "today" (YYYY-MM-DD) for a fully reproducible demo; empty = real date (IST).
AGNIDRISHTI_TODAY=
# Set to 0 to start with an empty database instead of auto-seeding.
AGNIDRISHTI_AUTO_SEED=1

# Local storage
AGNIDRISHTI_MODELS_DIR=backend/var/models
AGNIDRISHTI_STORAGE_DIR=backend/var/storage
AGNIDRISHTI_MAX_UPLOAD_MB=10
AGNIDRISHTI_LOG_LEVEL=INFO
# Demo user assumed when a request has no X-Demo-User header (read-only role by default).
AGNIDRISHTI_DEFAULT_DEMO_USER=senior.mgmt
# Where the built UI is served from.
AGNIDRISHTI_FRONTEND_DIST=frontend/dist

# Optional: AI-assisted wording for the dossier narrative (and an API-only category suggestion).
# Leave empty to run fully offline; every feature has a local fallback.
# The key stays on the server and is never sent to the browser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_TIMEOUT_S=20
